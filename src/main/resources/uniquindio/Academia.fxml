<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="uniquindio.ViewController.AcademiaViewController"
            prefHeight="1100" prefWidth="700">
    <left>
        <VBox spacing="12" prefWidth="190" style="-fx-background-color:orange;">
            <padding>
                <Insets top="25" right="25" left="25" bottom="25" />
            </padding>
            <Label text="Academia" style="-fx-text-fill: white; -fx-font-size: 20px;"/>
            <Button text="Estudiantes" maxWidth="Infinity" onAction="#mostrarVistaEstudiantes"/>
            <Button text="Profesores" maxWidth="Infinity" onAction="#mostrarVistaProfesores"/>
            <Button text="Cursos" maxWidth="Infinity" onAction="#mostrarVistaCursos"/>
            <Button text="Matricula" maxWidth="Infinity" onAction="#mostrarVistaMatricula"/>
            <Button text="Reportes" maxWidth="Infinity" onAction="#mostrarVistaReportes"/>
        </VBox>
    </left>
    <center>
        <StackPane fx:id="contenedorContenido"/>
    </center>
</BorderPane>
