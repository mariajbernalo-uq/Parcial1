<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="uniquindio.ViewController.ProfesorViewController"
      spacing="15">

    <padding>
        <Insets top="25" right="25" bottom="25" left="25"/>
    </padding>

    <Label text="Profesores"
           style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <GridPane hgap="12" vgap="12">
        <Label text="Documento (ID):"
               GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="txtDocumento"
                   GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label text="Nombre:"
               GridPane.columnIndex="2" GridPane.rowIndex="0"/>
        <TextField fx:id="txtNombre"
                   GridPane.columnIndex="3" GridPane.rowIndex="0"/>

        <Label text="Idioma:"
               GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <ComboBox fx:id="cmbIdioma"
                  promptText="Selecciona un idioma"
                  prefWidth="180"
                  GridPane.columnIndex="1" GridPane.rowIndex="1"/>

        <Label text="Teléfono:"
               GridPane.columnIndex="2" GridPane.rowIndex="1"/>
        <TextField fx:id="txtTelefono"
                   GridPane.columnIndex="3" GridPane.rowIndex="1"/>

        <Label text="Tarifa por sesión:"
               GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <TextField fx:id="txtTarifaSesion"
                   promptText="Ejemplo: 50000"
                   GridPane.columnIndex="1" GridPane.rowIndex="2"/>
    </GridPane>

    <HBox spacing="10">
        <Button text="Registrar" onAction="#registrar"/>
        <Button text="Actualizar" onAction="#actualizar"/>
        <Button text="Eliminar" onAction="#eliminar"/>
        <Button text="Limpiar" onAction="#limpiar"/>
    </HBox>

    <HBox spacing="10">
        <TextField fx:id="txtBuscarDocumento"
                   promptText="Buscar por documento"/>
        <Button text="Buscar" onAction="#buscar"/>
        <Button text="Mostrar todos" onAction="#mostrarTodos"/>
    </HBox>

    <TableView fx:id="tablaProfesores" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colDocumento"
                         text="Documento" prefWidth="150"/>
            <TableColumn fx:id="colNombre"
                         text="Nombre" prefWidth="220"/>
            <TableColumn fx:id="colIdioma"
                         text="Idioma" prefWidth="160"/>
            <TableColumn fx:id="colTelefono"
                         text="Teléfono" prefWidth="160"/>
            <TableColumn fx:id="colTarifaSesion"
                         text="Tarifa por sesión" prefWidth="160"/>
        </columns>
    </TableView>

</VBox>
