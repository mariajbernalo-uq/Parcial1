<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ViewController.CursoViewController">

    <top>

        <Label text="GESTIÓN DE CURSOS"
               style="-fx-font-size: 24px; -fx-font-weight: bold;"
               BorderPane.alignment="CENTER">

            <BorderPane.margin>
                <Insets top="15" bottom="15"/>
            </BorderPane.margin>

        </Label>

    </top>


    <center>

        <ScrollPane fitToWidth="true">

            <content>

                <VBox spacing="15">

                    <padding>
                        <Insets top="15"
                                right="20"
                                bottom="15"
                                left="20"/>
                    </padding>


                    <!-- DATOS DEL CURSO -->

                    <Label text="Datos del curso"
                           style="-fx-font-size: 18px; -fx-font-weight: bold;"/>


                    <GridPane hgap="10" vgap="10">

                        <Label text="Código:"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="0"/>

                        <TextField fx:id="txtCodigo"
                                   promptText="Código"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="0"/>


                        <Label text="Nombre:"
                               GridPane.columnIndex="2"
                               GridPane.rowIndex="0"/>

                        <TextField fx:id="txtNombre"
                                   promptText="Nombre"
                                   GridPane.columnIndex="3"
                                   GridPane.rowIndex="0"/>


                        <Label text="Tipo:"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="1"/>

                        <ComboBox fx:id="cmbTipoCurso"
                                  onAction="#actualizarPanelPersonalizado"
                                  prefWidth="180"
                                  GridPane.columnIndex="1"
                                  GridPane.rowIndex="1"/>


                        <Label text="Idioma:"
                               GridPane.columnIndex="2"
                               GridPane.rowIndex="1"/>

                        <ComboBox fx:id="cmbIdioma"
                                  prefWidth="180"
                                  GridPane.columnIndex="3"
                                  GridPane.rowIndex="1"/>


                        <Label text="Duración (meses):"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="2"/>

                        <TextField fx:id="txtDuracionMeses"
                                   promptText="Meses"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="2"/>


                        <Label text="Valor mensual:"
                               GridPane.columnIndex="2"
                               GridPane.rowIndex="2"/>

                        <TextField fx:id="txtValorMensual"
                                   promptText="Valor"
                                   GridPane.columnIndex="3"
                                   GridPane.rowIndex="2"/>


                        <Label text="Estado:"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="3"/>

                        <ComboBox fx:id="cmbEstado"
                                  prefWidth="180"
                                  GridPane.columnIndex="1"
                                  GridPane.rowIndex="3"/>

                    </GridPane>


                    <Label text="Descripción:"/>

                    <TextArea fx:id="txtDescripcion"
                              prefRowCount="3"
                              promptText="Descripción del curso"/>


                    <!-- CURSO PERSONALIZADO -->

                    <VBox fx:id="panelPersonalizado"
                          spacing="10">

                        <Label text="Información del curso personalizado"
                               style="-fx-font-size: 18px; -fx-font-weight: bold;"/>


                        <GridPane hgap="10" vgap="10">

                            <Label text="Cantidad de sesiones:"
                                   GridPane.columnIndex="0"
                                   GridPane.rowIndex="0"/>

                            <TextField fx:id="txtCantidadSesiones"
                                       promptText="Sesiones"
                                       GridPane.columnIndex="1"
                                       GridPane.rowIndex="0"/>


                            <Label text="Nivel:"
                                   GridPane.columnIndex="2"
                                   GridPane.rowIndex="0"/>

                            <ComboBox fx:id="cmbNivelReferencia"
                                      prefWidth="180"
                                      GridPane.columnIndex="3"
                                      GridPane.rowIndex="0"/>

                        </GridPane>


                        <Label text="Objetivos del estudiante:"/>

                        <TextArea fx:id="txtObjetivoEstudiante"
                                  prefRowCount="3"
                                  promptText="Objetivos"/>

                    </VBox>


                    <!-- BOTONES -->

                    <HBox spacing="10">

                        <Button text="Registrar"
                                onAction="#registrar"/>

                        <Button text="Actualizar"
                                onAction="#actualizar"/>

                        <Button text="Eliminar"
                                onAction="#eliminar"/>

                        <Button text="Buscar"
                                onAction="#buscar"/>

                        <Button text="Mostrar todos"
                                onAction="#mostrarTodos"/>

                        <Button text="Limpiar"
                                onAction="#limpiar"/>

                    </HBox>


                    <Separator/>


                    <!-- BENEFICIOS -->

                    <Label text="Beneficios del curso"
                           style="-fx-font-size: 18px; -fx-font-weight: bold;"/>


                    <GridPane hgap="10" vgap="10">

                        <Label text="Código:"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="0"/>

                        <TextField fx:id="txtCodigoBeneficio"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="0"/>


                        <Label text="Nombre:"
                               GridPane.columnIndex="2"
                               GridPane.rowIndex="0"/>

                        <TextField fx:id="txtNombreBeneficio"
                                   GridPane.columnIndex="3"
                                   GridPane.rowIndex="0"/>

                    </GridPane>


                    <Label text="Descripción del beneficio:"/>

                    <TextArea fx:id="txtDescripcionBeneficio"
                              prefRowCount="2"/>


                    <Button text="Crear beneficio"
                            onAction="#crearBeneficio"/>


                    <Separator/>


                    <!-- TABLA -->

                    <Label text="Cursos registrados"
                           style="-fx-font-size: 18px; -fx-font-weight: bold;"/>


                    <TableView fx:id="tablaCursos"
                               prefHeight="350">

                        <columns>

                            <TableColumn fx:id="colCodigo"
                                         text="Código"
                                         prefWidth="80"/>

                            <TableColumn fx:id="colNombre"
                                         text="Nombre"
                                         prefWidth="120"/>

                            <TableColumn fx:id="colTipo"
                                         text="Tipo"
                                         prefWidth="100"/>

                            <TableColumn fx:id="colIdioma"
                                         text="Idioma"
                                         prefWidth="100"/>

                            <TableColumn fx:id="colDuracion"
                                         text="Meses"
                                         prefWidth="70"/>

                            <TableColumn fx:id="colValorMensual"
                                         text="Valor mensual"
                                         prefWidth="100"/>

                            <TableColumn fx:id="colEstado"
                                         text="Estado"
                                         prefWidth="100"/>

                            <TableColumn fx:id="colSesiones"
                                         text="Sesiones"
                                         prefWidth="80"/>

                            <TableColumn fx:id="colNivel"
                                         text="Nivel"
                                         prefWidth="70"/>

                            <TableColumn fx:id="colObjetivo"
                                         text="Objetivo"
                                         prefWidth="150"/>

                            <TableColumn fx:id="colBeneficios"
                                         text="Beneficios"
                                         prefWidth="150"/>

                        </columns>

                    </TableView>

                </VBox>

            </content>

        </ScrollPane>

    </center>

</BorderPane>