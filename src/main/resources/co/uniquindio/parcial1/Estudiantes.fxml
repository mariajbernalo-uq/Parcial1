<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="ViewController.EstudianteViewController"
      spacing="15">

    <padding>
        <Insets top="25" right="25" left="25" bottom="25"/>
    </padding>

    <Label text="Estudiantes"
           style="-fx-font-size: 24px; -fx-font-weight: bold"/>

    <GridPane hgap="12" vgap="12">

        <Label text="Nombre:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="0"/>

        <TextField fx:id="txtNombre"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="0"/>

        <Label text="Documento:"
               GridPane.columnIndex="2"
               GridPane.rowIndex="0"/>

        <TextField fx:id="txtDocumento"
                   GridPane.columnIndex="3"
                   GridPane.rowIndex="0"/>


        <Label text="Teléfono:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="1"/>

        <TextField fx:id="txtTelefono"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="1"/>

        <Label text="Correo:"
               GridPane.columnIndex="2"
               GridPane.rowIndex="1"/>

        <TextField fx:id="txtCorreo"
                   GridPane.columnIndex="3"
                   GridPane.rowIndex="1"/>


        <Label text="Edad:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="2"/>

        <TextField fx:id="txtEdad"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="2"/>

        <Label text="Fecha de registro:"
               GridPane.columnIndex="2"
               GridPane.rowIndex="2"/>

        <TextField fx:id="fechaRegistro"
                   editable="false"
                   GridPane.columnIndex="3"
                   GridPane.rowIndex="2"/>

    </GridPane>


    <HBox spacing="10">

        <Button text="Registrar"
                onAction="#registrar"/>

        <Button text="Actualizar"
                onAction="#actualizar"/>

        <Button text="Eliminar"
                onAction="#eliminar"/>

        <Button text="Limpiar"
                onAction="#limpiar"/>

    </HBox>


    <HBox spacing="10">

        <TextField fx:id="txtBuscarDocumento"
                   promptText="Buscar por documento"/>

        <Button text="Buscar"
                onAction="#buscar"/>

        <Button text="Mostrar todos"
                onAction="#mostrarTodos"/>

    </HBox>


    <TableView fx:id="tablaEstudiantes"
               VBox.vgrow="ALWAYS">

        <columns>

            <TableColumn fx:id="colNombre"
                         text="Nombre"
                         prefWidth="170"/>

            <TableColumn fx:id="colDocumento"
                         text="Documento"
                         prefWidth="130"/>

            <TableColumn fx:id="colTelefono"
                         text="Teléfono"
                         prefWidth="130"/>

            <TableColumn fx:id="colCorreo"
                         text="Correo"
                         prefWidth="220"/>

            <TableColumn fx:id="colEdad"
                         text="Edad"
                         prefWidth="70"/>

            <TableColumn fx:id="colFechaRegistro"
                         text="Fecha de registro"
                         prefWidth="150"/>

        </columns>

    </TableView>

</VBox>