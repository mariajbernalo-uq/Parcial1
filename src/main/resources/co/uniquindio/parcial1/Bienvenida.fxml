<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER"
      spacing="20.0"
      style="-fx-background-color: #FFFFFF; -fx-border-color: orange; -fx-border-width: 2; -fx-font-family: 'Fira Code'"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="ViewController.BienvenidaViewController">

    <padding>
        <Insets bottom="60.0"
                left="60.0"
                right="60.0"
                top="60.0"/>
    </padding>

    <children>

        <Label text="Academia LenguajeCafetero"
               style="-fx-font-weight: bold; -fx-font-size: 25;"/>

        <Label text="Bienvenido al sistema de registros de la academia"
               textAlignment="CENTER"
               wrapText="true"
               style="-fx-font-size: 14; -fx-font-family: 'Calisto MT'"/>

        <Label fx:id="textoBienvenida"/>

        <Button text="Ingresar!"
                onAction="#onOpenAcademia"
                prefHeight="40"
                prefWidth="180"
                style="-fx-font-family: 'Fira Code'; -fx-background-color: black; -fx-text-fill: white"/>

    </children>

</VBox>